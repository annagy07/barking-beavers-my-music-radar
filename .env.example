# --- Database ---------------------------------------------------------------
# Any plain postgres:// / postgresql:// connection string works. Easiest
# options:
#  - Vercel: project → Storage tab → Create Database → connect it to the
#    project. If it's "Prisma Postgres", use the *_POSTGRES_URL variable
#    it creates (a direct connection) — its *_URL one is a
#    prisma+postgres:// Accelerate URL this app doesn't use.
#  - Neon.tech / Supabase directly (both have a free tier).
#  - Local Postgres for development, e.g.:
#    DATABASE_POSTGRES_URL="postgresql://app:app@localhost:5432/barking_beaver"
DATABASE_POSTGRES_URL="postgresql://user:password@host:5432/dbname"

# --- Spotify (Authorization Code + PKCE) -------------------------------------
# Create an app at https://developer.spotify.com/dashboard, add
# SPOTIFY_REDIRECT_URI as a Redirect URI there, then paste the Client ID/Secret
# below. If these are left blank, the app automatically falls back to a
# realistic mock Spotify connection so onboarding still works end to end.
SPOTIFY_CLIENT_ID=""
SPOTIFY_CLIENT_SECRET=""
SPOTIFY_REDIRECT_URI="http://localhost:3000/api/spotify/callback"

# --- App / session ------------------------------------------------------------
# Any random string. Used to sign the lightweight dev session cookie.
APP_SESSION_SECRET="dev-secret-change-me"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Email delivery (optional) ------------------------------------------------
# Leave unset to use the built-in console/mock EmailProvider. Set both to
# switch the adapter to Resend in lib/email.
RESEND_API_KEY=""
EMAIL_FROM="Barking Beaver <radar@example.com>"
