// Barking Beaver — Prisma schema
// Runs on PostgreSQL (works great on Vercel Postgres/Neon/Prisma Postgres'
// free tiers). Field types (String IDs, JSON-as-string, String "enums")
// were kept deliberately simple during early development so the schema
// also ran on SQLite with zero changes — they still work fine on
// Postgres, and could later be promoted to native `enum` types / `Json`
// columns if desired.
//
// DATABASE_POSTGRES_URL (not DATABASE_URL): if you're using "Prisma
// Postgres" via Vercel's Storage tab, its DATABASE_URL is a
// prisma+postgres:// Accelerate URL that only the extended client can
// use — DATABASE_POSTGRES_URL is the plain, direct connection string the
// CLI (and this app, since it doesn't use the Accelerate extension) needs.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_POSTGRES_URL")
}

// ---------------------------------------------------------------------------
// Identity & consent
// ---------------------------------------------------------------------------

model User {
  id        String   @id @default(cuid())
  email     String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  artistPreferences       UserArtistPreference[]
  preference               UserPreference?
  connectedAccounts       ConnectedAccount[]
  consents                Consent[]
  newsletterSubscription  NewsletterSubscription?
}

/// Consent ledger. One row per consent event, never mutated in place —
/// withdrawing consent writes a new state rather than deleting history.
model Consent {
  id                  String    @id @default(cuid())
  userId              String
  channel             String // "email" | "whatsapp"
  consentStatus       String // "granted" | "withdrawn"
  consentTimestamp    DateTime  @default(now())
  consentTextVersion  String
  withdrawalTimestamp DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, channel])
}

/// OAuth-connected external accounts (Spotify today, Bandsintown later).
/// We deliberately do not store raw listening history — only enough to
/// re-derive artist preferences and to know the connection is live.
model ConnectedAccount {
  id                String    @id @default(cuid())
  userId            String
  provider          String // "spotify"
  providerAccountId String?
  accessToken       String?
  refreshToken       String?
  expiresAt         DateTime?
  scope             String?
  connectedAt       DateTime  @default(now())
  disconnectedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
}

/// Holds an imported Spotify artist list (and tokens) between "Connect
/// Spotify" and account creation at the end of onboarding — before a User
/// exists to attach it to. Only a short-lived random id lives in the
/// browser cookie; the payload itself lives here because a real account's
/// follow/top/saved list is routinely too large for a cookie (~4KB limit).
/// Rows are deleted once onboarding finishes (or left to age out otherwise).
model SpotifyImportDraft {
  id           String   @id @default(cuid())
  artistsJson  String
  accessToken  String?
  refreshToken String?
  scope        String?
  connectedAt  DateTime @default(now())
  createdAt    DateTime @default(now())
}

model NewsletterSubscription {
  id        String   @id @default(cuid())
  userId    String   @unique
  email     String
  status    String   @default("active") // "active" | "paused" | "unsubscribed"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Taste graph
// ---------------------------------------------------------------------------

model Artist {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  genres    String // JSON string array, e.g. ["indie","post-punk"]
  imageUrl  String?
  country   String?
  labelName String?
  spotifyId String?
  bio       String?
  createdAt DateTime @default(now())

  userPreferences UserArtistPreference[]
  events          MusicEvent[]
  relatedFrom     ArtistRelation[]       @relation("relationFrom")
  relatedTo       ArtistRelation[]       @relation("relationTo")
}

/// Explainable discovery edges: why English Teacher gets suggested to a
/// Fontaines D.C. fan. Mock/manually curated for the MVP.
model ArtistRelation {
  id           String  @id @default(cuid())
  fromArtistId String
  toArtistId   String
  reasonType   String // "same_genre" | "same_label" | "shared_festival_lineup" | "support_act" | "collaboration" | "shared_producer" | "manual"
  note         String?

  fromArtist Artist @relation("relationFrom", fields: [fromArtistId], references: [id], onDelete: Cascade)
  toArtist   Artist @relation("relationTo", fields: [toArtistId], references: [id], onDelete: Cascade)

  @@unique([fromArtistId, toArtistId])
}

model UserArtistPreference {
  id              String   @id @default(cuid())
  userId          String
  artistId        String
  source          String // "manual" | "spotify_top_artist" | "spotify_followed_artist" | "spotify_saved_music"
  relevance       String // "essential" | "interested" | "occasional"
  baseWeight      Int // deterministic weight derived from source, user-overridable
  blocked         Boolean  @default(false)
  confirmedByUser Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  artist Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@unique([userId, artistId])
}

model UserPreference {
  id                   String   @id @default(cuid())
  userId               String   @unique
  contentCategories    String // JSON array string, e.g. ["new_singles","concerts"]
  discoveryLevel       Int      @default(3) // 1 (only known artists) .. 5 (surprise me)
  city                 String?
  concertRadiusKm      Int      @default(50)
  concertLookaheadDays Int      @default(90)
  newsletterFrequency  String   @default("weekly") // "weekly" | "twice_weekly" | "daily"
  instantPresaleAlerts Boolean  @default(false)
  updatedAt            DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Content graph
// ---------------------------------------------------------------------------

model MusicSource {
  id               String @id @default(cuid())
  name             String
  type             String // "official_artist_site" | "official_label" | "official_youtube" | "spotify" | "venue" | "music_publication" | "unverified_social"
  credibilityScore Int
  url              String?

  events MusicEvent[]
}

model MusicEvent {
  id               String    @id @default(cuid())
  type             String // "release" | "upcoming_release" | "concert" | "tour" | "presale" | "video" | "interview" | "collaboration" | "fact" | "discovery"
  subtype          String? // release: "single" | "ep" | "album"; fact: "behind_the_scenes" | "interesting_fact"
  artistId         String
  title            String
  description      String
  publishedAt      DateTime
  eventDate        DateTime?
  city             String?
  venue            String?
  genreTags        String // JSON array string
  sourceId         String
  sourceUrl        String?
  credibilityScore Int // denormalized snapshot of source credibility at ingest time
  createdAt        DateTime  @default(now())

  artist Artist      @relation(fields: [artistId], references: [id], onDelete: Cascade)
  source MusicSource @relation(fields: [sourceId], references: [id])

  @@index([type])
  @@index([artistId])
}
